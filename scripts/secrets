#!/usr/bin/env python3
"""The secrets helper: everyday maintenance of the encrypted store without ever writing plaintext to disk
(epic 22 ticket #04). It replaces the old interactive prompt script (setup-env.sh).

    scripts/secrets check                             names missing (required) or undeclared, by name only
    scripts/secrets fill                               guided hidden-input fill of missing required values
    scripts/secrets edit                               edit the store in $EDITOR
    scripts/secrets add-recipient AGE-PUBLIC-KEY        add a recipient (creates .sops.yaml if it doesn't exist yet)
    scripts/secrets remove-recipient AGE-PUBLIC-KEY     remove a recipient and re-key the store
    scripts/secrets rotate                             generate a new data encryption key (same recipients)
    scripts/secrets init-key [PATH]                     create a new age identity; print ONLY its public key
    scripts/secrets import PLAINTEXT-ENV-FILE           import a plaintext env file, verified by a round-trip digest

Every command that changes the store's CONTENT builds the new plaintext entirely in the process's memory and feeds
it to `sops` over a pipe (stdin in, ciphertext out on stdout); only the ciphertext is written to disk, and it is
written atomically (a temp file in the store's own directory, then renamed over the original). `add-recipient`,
`remove-recipient` and `rotate` never touch a value at all: SOPS re-wraps the existing ciphertext's data key for
the new recipient set, or replaces the data key and re-encrypts with it, without ever exposing a value to this
script. No command ever prints a decrypted value.

How `edit` works: it delegates to `sops edit`, which SOPS itself implements by decrypting to a temporary file
(mode 0600), launching $EDITOR on it, re-encrypting on a clean exit, and removing the temporary file whether
editing succeeded or not (verified: this holds even when the editor makes no change). This script points TMPDIR
at a private, per-user runtime directory (a tmpfs) when one is available, so that temporary file never touches
persistent storage; scripts/deploy makes the same choice independently for its own, unrelated temp needs — the
two are not shared code because scripts/deploy's constraints (an ssh control-socket path length limit) are its
own, already reviewed and mutation-tested.

Configuration: the same HERMES_SECRETS_STORE / HERMES_SECRETS_KEY_FILE / SOPS_AGE_KEY_CMD the deploy wrapper reads.
"""
import argparse
import getpass
import os
import stat
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:] = [p for p in sys.path if os.path.realpath(p or os.getcwd()) != _HERE]
import importlib.util  # noqa: E402


def _load(name):
    """Load scripts/<name>.py from its explicit path (never through sys.path, so nothing else can take its place)."""
    spec = importlib.util.spec_from_file_location(name, os.path.join(_HERE, name + ".py"))
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


hs = _load("hermes_secrets")

EX_REFUSED = 64
EX_CONFIG = 78
MAX_SCRATCH_PARENT = 40   # (independent of, but the same value as, scripts/deploy's own — see the module docstring)


def scratch_dir():
    """A private (0700) directory for the store's own atomic-write temp files and for sops edit's TMPDIR."""
    parent = None
    for candidate in (os.environ.get("XDG_RUNTIME_DIR"), "/dev/shm", "/tmp"):
        if candidate and len(candidate) <= MAX_SCRATCH_PARENT and os.path.isdir(candidate) and os.access(candidate, os.W_OK):
            parent = candidate
            break
    path = tempfile.mkdtemp(prefix="hermes-secrets-", dir=parent)
    os.chmod(path, 0o700)
    return path


def run_sops(args, environ, input_bytes=None, cwd=None):
    """Run sops, capturing output; never lets its stderr (which can name a decrypted line, see hermes_secrets.py) escape
    on failure — only a fixed-vocabulary reason does."""
    proc = subprocess.run(["sops"] + args, input=input_bytes, capture_output=True, cwd=cwd, env=hs.sops_env(environ))
    return proc


def sops_failure(proc):
    return hs.SecretsError("sops %s failed (%s)" % (proc.args[1] if len(proc.args) > 1 else "?",
                                                     hs._sops_failure_reason(proc.stderr.decode("utf-8", "replace") if proc.stderr else "")))


def write_atomic(path, data):
    """Replace `path` with `data` without ever leaving a partial file: a temp file in the SAME directory (so the
    final rename is on one filesystem), 0600, then renamed over the original."""
    directory = os.path.dirname(os.path.realpath(path)) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".secrets.enc.env.")
    try:
        os.chmod(tmp, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def encrypt_to_store(root, store, plaintext_bytes, environ):
    """Encrypt `plaintext_bytes` (a dotenv document) for the store's own recipients (from .sops.yaml, resolved by
    --filename-override) and write it atomically. The plaintext passes through a pipe to sops's stdin; it is never
    written to disk by this function."""
    rel = os.path.relpath(store, root)
    proc = run_sops(["encrypt", "--input-type", "dotenv", "--output-type", "dotenv", "--filename-override", rel],
                    environ, input_bytes=plaintext_bytes, cwd=root)
    if proc.returncode != 0:
        raise sops_failure(proc)
    write_atomic(store, proc.stdout)


def store_exists(store):
    """True if a real (non-symlink) store file exists. A symlink at the store path is refused outright, never
    silently followed for a read or a write — its target could be anything readable/writable on the machine,
    including the operator's own real .env (the same reason ticket #03's structural guard refuses one at lint time;
    this is the same guarantee enforced at the moment of use, not only at lint time)."""
    if os.path.islink(store):
        raise hs.SecretsError("%s is a symlink; refusing to read or write through it" % store)
    return os.path.isfile(store)


def cmd_check(args, environ):
    root = hs.REPO_ROOT
    store = hs.store_path(root, environ)
    if not store_exists(store):
        print("secrets check: no encrypted store at %s yet" % store, file=sys.stderr)
        return EX_CONFIG
    with open(store, "r", encoding="utf-8", errors="replace") as fh:
        names = hs.store_names(fh.read())
    missing, undeclared = hs.apply_name_set(names, hs.required_names(root), hs.allowed_names(root))
    if not missing and not undeclared:
        print("secrets check: OK (%d name(s), all required present, none undeclared)" % len(names))
        return 0
    if missing:
        print("missing (required): " + ", ".join(missing))
    if undeclared:
        print("undeclared (neither a manifest name nor a declared extra): " + ", ".join(undeclared))
    return 1


def cmd_fill(args, environ):
    root = hs.REPO_ROOT
    store = hs.store_path(root, environ)
    values, problems = hs.preflight(root, environ)
    if values is None:
        # preflight refuses on an undeclared name too; for `fill` that is not fatal — recover the store's OWN
        # decryptable values directly so a stray name doesn't block filling in what IS missing.
        if not store_exists(store):
            for p in problems:
                print("secrets fill: %s" % p, file=sys.stderr)
            return EX_CONFIG
        try:
            values = hs.decrypt_store(store, environ)
        except hs.SecretsError as exc:
            print("secrets fill: %s" % exc, file=sys.stderr)
            return EX_CONFIG
    missing = [n for n in hs.required_names(root) if not values.get(n)]
    if not missing:
        print("secrets fill: nothing required is missing")
        return 0
    if not sys.stdin.isatty():
        print("secrets fill: needs an interactive terminal (missing: %s)" % ", ".join(missing), file=sys.stderr)
        return EX_CONFIG
    print("Filling %d missing required value(s). Input is hidden; press Enter to leave one blank and stop." % len(missing))
    for name in missing:
        try:
            value = getpass.getpass("%s: " % name)
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not value:
            print("(left blank; stopping)")
            break
        values[name] = value
    doc = "\n".join("%s=%s" % (k, v) for k, v in sorted(values.items())) + "\n"
    encrypt_to_store(root, store, doc.encode("utf-8"), environ)
    print("secrets fill: store updated")
    return 0


def cmd_edit(args, environ):
    root = hs.REPO_ROOT
    store = hs.store_path(root, environ)
    if not store_exists(store):
        print("secrets edit: no encrypted store at %s yet (use `import` or `add-recipient` first)" % store, file=sys.stderr)
        return EX_CONFIG
    scratch = scratch_dir()
    try:
        env = dict(environ)
        env.update(hs.sops_env(environ))
        env["TMPDIR"] = scratch
        # stderr is captured (never inherited straight to the terminal) so a decrypt/parse failure here goes through
        # the same fixed-vocabulary mapping every other command uses, instead of sops printing its own diagnostic
        # text — which, on a corrupted or malformed store, can echo a decrypted plaintext line or key material
        # verbatim. stdin/stdout stay inherited: sops itself launches $EDITOR against the real terminal.
        proc = subprocess.run(["sops", "edit", "--input-type", "dotenv", "--output-type", "dotenv", store],
                               env=env, stderr=subprocess.PIPE)
        if proc.returncode not in (0, 200):   # 200 = sops's own "no changes made" status, not a failure
            raise sops_failure(proc)
        return 0
    finally:
        import shutil
        shutil.rmtree(scratch, ignore_errors=True)


def load_sops_config(path):
    import yaml
    if not os.path.isfile(path):
        return None
    with open(path, "r", encoding="utf-8") as fh:
        return yaml.safe_load(fh) or {}


def save_sops_config(path, config):
    import yaml
    with open(path, "w", encoding="utf-8") as fh:
        yaml.safe_dump(config, fh, default_flow_style=False, sort_keys=False)


def store_rule(config, store_rel):
    """The FIRST creation_rules entry whose path_regex matches the store's path (SOPS's own semantics — see
    scripts/check_secrets_store.py's config_recipients, which this mirrors)."""
    import re
    for rule in config.get("creation_rules") or []:
        if isinstance(rule, dict) and rule.get("path_regex") and re.search(rule["path_regex"], store_rel):
            return rule
    return None


def persist_config_rekeying(config_path, config, store, root, environ):
    """Persist `config` to `config_path` and, if a store already exists, re-key it via `sops updatekeys` for the
    NEW recipient set. If updatekeys fails, the config file is rolled back to exactly what it held before this call
    (restored verbatim, or removed if it didn't exist) and the failure is raised — so .sops.yaml and the store's
    real recipients can never end up left out of sync by a partial failure (a permission hiccup, a full disk, or a
    Ctrl-C landing between the two writes)."""
    old_text = None
    had_config = os.path.isfile(config_path)
    if had_config:
        with open(config_path, "r", encoding="utf-8") as fh:
            old_text = fh.read()
    save_sops_config(config_path, config)
    if not store_exists(store):
        return None
    proc = run_sops(["updatekeys", "-y", "--input-type", "dotenv", store], environ, cwd=root)
    if proc.returncode != 0:
        if had_config:
            with open(config_path, "w", encoding="utf-8") as fh:
                fh.write(old_text)
        else:
            os.unlink(config_path)
        raise sops_failure(proc)
    return proc.stdout.decode("utf-8", "replace")


def cmd_add_recipient(args, environ):
    root = hs.REPO_ROOT
    key = args.age_public_key.strip()
    if not hs.valid_age_recipient(key):
        print("secrets add-recipient: %r is not a valid age public key" % key, file=sys.stderr)
        return EX_REFUSED
    store = hs.store_path(root, environ)
    store_rel = os.path.relpath(store, root)
    config_path = os.path.join(root, ".sops.yaml")
    config = load_sops_config(config_path)
    if config is None:
        config = {"creation_rules": [{"path_regex": "^%s$" % store_rel.replace(".", r"\."),
                                      "key_groups": [{"age": [key]}]}]}
        save_sops_config(config_path, config)
        print("secrets add-recipient: created .sops.yaml with this recipient (no store yet)")
        return 0
    rule = store_rule(config, store_rel)
    if rule is None:
        print("secrets add-recipient: .sops.yaml has no rule for %s (edit it by hand first)" % store_rel, file=sys.stderr)
        return EX_CONFIG
    groups = rule.setdefault("key_groups", [{"age": []}])
    recipients = groups[0].setdefault("age", [])
    if key in recipients:
        print("secrets add-recipient: already a recipient")
        return 0
    recipients.append(key)
    out = persist_config_rekeying(config_path, config, store, root, environ)
    if out is not None:
        print(out)
        print("secrets add-recipient: added to .sops.yaml and re-keyed the store")
    else:
        print("secrets add-recipient: added to .sops.yaml (no store yet)")
    return 0


def cmd_remove_recipient(args, environ):
    root = hs.REPO_ROOT
    key = args.age_public_key.strip()
    store = hs.store_path(root, environ)
    store_rel = os.path.relpath(store, root)
    config_path = os.path.join(root, ".sops.yaml")
    config = load_sops_config(config_path)
    if config is None:
        print("secrets remove-recipient: no .sops.yaml", file=sys.stderr)
        return EX_CONFIG
    rule = store_rule(config, store_rel)
    if rule is None:
        print("secrets remove-recipient: .sops.yaml has no rule for %s" % store_rel, file=sys.stderr)
        return EX_CONFIG
    groups = rule.get("key_groups") or [{}]
    recipients = groups[0].get("age") or []
    if key not in recipients:
        print("secrets remove-recipient: not a recipient")
        return 0
    if len(recipients) <= 1:
        print("secrets remove-recipient: refusing to remove the only recipient (nobody could decrypt the store)", file=sys.stderr)
        return EX_REFUSED
    recipients.remove(key)
    out = persist_config_rekeying(config_path, config, store, root, environ)
    if out is not None:
        print(out)
    print("secrets remove-recipient: removed. This does NOT protect any version already committed to git history —")
    print("if the removed key may have been compromised, rotate the data key (`secrets rotate`) and the credentials themselves.")
    return 0


def cmd_rotate(args, environ):
    root = hs.REPO_ROOT
    store = hs.store_path(root, environ)
    if not store_exists(store):
        print("secrets rotate: no encrypted store at %s" % store, file=sys.stderr)
        return EX_CONFIG
    proc = run_sops(["rotate", "-i", "--input-type", "dotenv", "--output-type", "dotenv", store], environ, cwd=root)
    if proc.returncode != 0:
        raise sops_failure(proc)
    print("secrets rotate: the data encryption key has been replaced (recipients unchanged)")
    return 0


def cmd_init_key(args, environ):
    path = os.path.abspath(os.path.expanduser(args.path or hs.DEFAULT_KEY_FILE))
    if os.path.exists(path):
        # age-keygen itself already refuses to overwrite an existing file (verified empirically), so this check is
        # not the only thing standing between an operator and losing a key — it only gives a clearer message before
        # invoking the tool at all.
        print("secrets init-key: %s already exists; refusing to overwrite it" % path, file=sys.stderr)
        return EX_REFUSED
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    proc = subprocess.run(["age-keygen", "-o", path], capture_output=True)
    if proc.returncode != 0:
        print("secrets init-key: age-keygen failed", file=sys.stderr)
        return EX_CONFIG
    os.chmod(path, 0o600)
    pub = subprocess.run(["age-keygen", "-y", path], capture_output=True, text=True)
    if pub.returncode != 0 or not pub.stdout.strip():
        print("secrets init-key: key created at %s, but could not read back its public key" % path, file=sys.stderr)
        return EX_CONFIG
    print(pub.stdout.strip())
    return 0


def cmd_import(args, environ):
    root = hs.REPO_ROOT
    store = hs.store_path(root, environ)
    src = args.plaintext_env_file
    if not os.path.isfile(src):
        print("secrets import: %s not found" % src, file=sys.stderr)
        return EX_CONFIG
    with open(src, "rb") as fh:
        source_bytes = fh.read()
    if not source_bytes.strip():
        print("secrets import: %s is empty" % src, file=sys.stderr)
        return EX_CONFIG
    # A duplicate NAME= line is refused up front, by name only: the round-trip check below runs the SAME source
    # bytes through sops' dotenv parser on both sides of the comparison, so it can never disagree with itself about
    # which of two conflicting assignments "wins" — this is the one class of data loss that check structurally
    # cannot catch, so it is caught here instead, before either encrypt happens.
    seen, dupes = set(), set()
    for line in source_bytes.decode("utf-8", "replace").splitlines():
        m = hs.NAME_LINE_RE.match(line)
        if not m:
            continue
        name = m.group(1)
        (dupes if name in seen else seen).add(name)
    if dupes:
        print("secrets import: %s assigns the same name more than once (by name): %s"
              % (src, ", ".join(sorted(dupes))), file=sys.stderr)
        return EX_CONFIG

    # The round-trip check: parse the SAME source bytes a second, independent way — a throwaway single-recipient
    # encryption (this operator's own key), decrypted straight back — and compare against what actually landed in the
    # real (possibly multi-recipient) store. Deliberately not a hand-written dotenv parser: sops is the one true
    # parser for this format (its quoting and escaping rules are its own), so using sops on both sides is what
    # proves the import lost nothing, rather than proving two parsers agree with each other.
    key = hs.key_file(environ)
    if not os.environ.get(hs.ENV_KEY_CMD) and not os.path.isfile(key):
        print("secrets import: your age key is missing: %s" % key, file=sys.stderr)
        return EX_CONFIG
    own_pub = subprocess.run(["age-keygen", "-y", key], capture_output=True, text=True) if os.path.isfile(key) else None
    if own_pub is None or own_pub.returncode != 0 or not own_pub.stdout.strip():
        print("secrets import: could not derive your public key for the round-trip check", file=sys.stderr)
        return EX_CONFIG
    # Run this pair OUTSIDE the repository (a directory with no .sops.yaml above it): --age alone should need no
    # config, but sops still looks for a .sops.yaml to load and gets confused finding one that has no rule for an
    # arbitrary throwaway path. cwd has nothing to do with where the store itself gets written (encrypt_to_store,
    # below, always runs with cwd=root).
    scratch = scratch_dir()
    try:
        check_proc = run_sops(["encrypt", "--age", own_pub.stdout.strip(), "--input-type", "dotenv", "--output-type", "json",
                               "--filename-override", "throwaway.json"], environ, input_bytes=source_bytes, cwd=scratch)
        if check_proc.returncode != 0:
            raise sops_failure(check_proc)
        decrypt_proc = run_sops(["decrypt", "--input-type", "json", "--output-type", "json"], environ,
                                input_bytes=check_proc.stdout, cwd=scratch)
        if decrypt_proc.returncode != 0:
            raise sops_failure(decrypt_proc)
    finally:
        import shutil
        shutil.rmtree(scratch, ignore_errors=True)
    import json
    source_values = json.loads(decrypt_proc.stdout)
    if not isinstance(source_values, dict):
        print("secrets import: %s is not a flat set of NAME=value pairs" % src, file=sys.stderr)
        return EX_CONFIG

    os.makedirs(os.path.dirname(store), mode=0o700, exist_ok=True)
    encrypt_to_store(root, store, source_bytes, environ)
    try:
        stored_values = hs.decrypt_store(store, environ)
    except hs.SecretsError as exc:
        print("secrets import: store written, but could not be read back for verification: %s" % exc, file=sys.stderr)
        return EX_CONFIG

    missing_names = sorted(set(source_values) - set(stored_values))
    extra_names = sorted(set(stored_values) - set(source_values))
    differing_names = sorted(n for n in source_values if n in stored_values and source_values[n] != stored_values[n])
    if missing_names or extra_names or differing_names:
        if missing_names:
            print("secrets import: names lost in the round trip (by name): " + ", ".join(missing_names), file=sys.stderr)
        if extra_names:
            print("secrets import: names that appeared that were not in the source (by name): " + ", ".join(extra_names), file=sys.stderr)
        if differing_names:
            print("secrets import: values changed in the round trip (by name): " + ", ".join(differing_names), file=sys.stderr)
        return EX_CONFIG

    missing, undeclared = hs.apply_name_set(stored_values.keys(), hs.required_names(root), hs.allowed_names(root))
    print("secrets import: %d name(s) imported, round-trip verified byte-for-byte (nothing printed above is a value)"
          % len(stored_values))
    if missing:
        print("secrets import: still missing (required): " + ", ".join(missing))
    if undeclared:
        print("secrets import: undeclared names carried over from the source: " + ", ".join(undeclared))
    return 0


def main(argv):
    parser = argparse.ArgumentParser(prog="secrets", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("check")
    sub.add_parser("fill")
    sub.add_parser("edit")
    p = sub.add_parser("add-recipient"); p.add_argument("age_public_key")
    p = sub.add_parser("remove-recipient"); p.add_argument("age_public_key")
    sub.add_parser("rotate")
    p = sub.add_parser("init-key"); p.add_argument("path", nargs="?")
    p = sub.add_parser("import"); p.add_argument("plaintext_env_file")
    args = parser.parse_args(argv)

    for tool in ("sops", "age", "age-keygen"):
        import shutil as _sh
        if _sh.which(tool) is None:
            print("secrets: %s is not installed" % tool, file=sys.stderr)
            return EX_CONFIG

    handlers = {
        "check": cmd_check, "fill": cmd_fill, "edit": cmd_edit,
        "add-recipient": cmd_add_recipient, "remove-recipient": cmd_remove_recipient,
        "rotate": cmd_rotate, "init-key": cmd_init_key, "import": cmd_import,
    }
    try:
        return handlers[args.command](args, os.environ)
    except hs.SecretsError as exc:
        print("secrets: %s" % exc, file=sys.stderr)
        return EX_CONFIG


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
