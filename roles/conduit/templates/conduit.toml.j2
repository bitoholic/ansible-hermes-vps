[global]
# Personal homeserver identity. Clients reach it over the internal Docker network as
# http://conduit:{{ conduit_port }}, and externally at https://{{ conduit_server_name }}:8448
# where Caddy terminates TLS with a real ACME cert (ADR-0003).
server_name = "{{ conduit_server_name }}"
address = "0.0.0.0"
port = {{ conduit_port }}

database_backend = "rocksdb"
database_path = "/var/lib/matrix-conduit/"
max_request_size = 20000000

# Personal, non-federated homeserver: registration is open but gated behind a static token,
# and federation is disabled so only accounts we create (operator + Hermes bot) exist.
allow_registration = true
registration_token = "{{ secrets.conduit_registration_secret }}"
allow_federation = false
allow_encryption = true
trusted_servers = []

# Plain HTTP on the bridge only: TLS is terminated by Caddy in front (ADR-0003). This
# container port must stay unpublished — the only ingress is the gateway network.
