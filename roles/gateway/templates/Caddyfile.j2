{
  # ACME contact (epic 12 #05/#08): Let's Encrypt expiry/abuse notices.
  email {{ secrets.acme_email }}
  servers {
    trusted_proxies static private_ranges
  }

  # Internal-only listener for tailnet-facing traffic (epic 20). Caddy's normal
  # public listener (:443, above/default — no servers block needed for it at
  # all, since omitting one leaves a listener completely unconfigured/default)
  # keeps its current behavior exactly as-is: no PROXY-protocol trust, no new
  # surface. This SEPARATE listener is where the caddy-relay container (host-
  # networked, bound to this VPS's own Tailscale IP — see roles/docker/
  # templates/services/caddy-relay.yml.j2) forwards tailnet-sourced
  # connections, wrapped in a PROXY protocol header carrying the real client
  # IP that Tailscale's own local-subnet masquerade would otherwise have
  # erased by the time a Docker-published port saw it (root cause: epic 20
  # spec). `proxy_protocol` needs NO Dockerfile change: verified directly
  # (`caddy list-modules` against the real pinned image) that
  # caddy.listeners.proxy_protocol already ships in stock Caddy 2.11.4 — it is
  # not a third-party plugin at this version (a first attempt at compiling in
  # a third-party proxy-protocol module via xcaddy panicked at runtime with
  # "module already registered", which is what surfaced this).
  #
  # A Unix domain socket, NOT a TCP port (an earlier version of this listener
  # was a plain port, e.g. :8543, with an IP `allow`-list as the trust
  # boundary) — found, in review, to be a real auth-bypass vector: ANY
  # host-networked container in this stack
  # (beszel-agent already is one) or host-level process can reach a Docker-
  # published 127.0.0.1 port, and Docker's own port-publish NAT rewrites ITS
  # source to the gateway network's bridge address too (confirmed against
  # moby/moby#45629) — the exact same range the relay's own connection
  # appeared from, so an IP allow-list could never actually distinguish "the
  # relay" from "anything else on the host." A Unix socket has no network-
  # layer identity to spoof at all: only a container with this exact
  # directory bind-mounted (caddy-relay does; nothing else does) can reach
  # the socket file — a boundary Docker's own volume-mount scoping enforces,
  # not an IP check. `allow` below is kept as a narrow, likely-redundant
  # belt-and-suspenders check (a Unix-socket peer may not even present an IP
  # for it to evaluate) — the REAL security boundary is the socket's
  # filesystem/mount scoping, not this list.
  #
  # Getting the mount scoping wrong (e.g. sharing this directory with an
  # unrelated container) would let anyone with access to the socket forge a
  # PROXY header claiming a tailnet source IP and fully bypass both mfa_auth
  # and tailnet_only below — treat this as a security boundary, not a config
  # nit. `proxy_protocol` must be loaded before `tls` in the wrapper chain
  # (unwraps the header before the TLS handshake starts), per the module's
  # own documented requirement.
  #
  # Syntax verified against a real Caddy binary (`caddy adapt`, not just
  # reasoned about): a Unix-socket address comma-joined onto a normal
  # hostname address in ONE site block (the original approach for the TCP
  # port design) silently mis-parses as a URL host+path match instead of a
  # second listener — Caddy's own docs confirm the correct pattern is a
  # SEPARATE site block per listener, using the `bind` directive, matching
  # the same hostname for routing. See the per-route rendering below. The
  # `servers` address here must match each route's own `bind` line
  # BYTE-FOR-BYTE, including the `|0666` permission suffix — verified
  # empirically that a mismatched suffix makes this listener_wrappers block
  # silently not apply at all, no error either way.
  servers unix//caddy-relay-socket/caddy-relay.sock|0666 {
    listener_wrappers {
      proxy_protocol {
        allow 127.0.0.1/32 ::1/128
      }
      tls
    }
  }
}

(mfa_auth) {
  # Source-based MFA (ADR-0001): Tailscale (VPN) clients are already authenticated and
  # encrypted, so they skip Authelia; everyone else (public net) is challenged. The subnet
  # is the single constant shared with the tailscale role's ufw allow. Both v4 and v6
  # tailnet ranges (epic 20 — tailscale_subnet_v6 existed already, used by the
  # DOCKER-USER v6 rules, but was never wired into this matcher until now; a
  # v6-connecting tailnet client was silently treated as "not tailscale" before this).
  @not_tailscale not remote_ip {{ tailscale_subnet }} {{ tailscale_subnet_v6 }}
  forward_auth @not_tailscale authelia:9091 {
    uri /api/authz/forward-auth?authelia_url=https://auth.<secret-silverbullet-domain>
    copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
  }
}

(tailnet_only) {
  # Hard-block private routes (epic 18, #01): unlike mfa_auth above, this is not a
  # challenge — non-Tailscale sources get a flat 404, no forward_auth involved, so
  # the route has no public path at all. Same tailscale_subnet/tailscale_subnet_v6
  # constants as mfa_auth (epic 20 added the v6 half to both matchers together).
  # Matcher deliberately named @not_tailscale_hard, distinct from mfa_auth's own
  # @not_tailscale — a route importing both snippets (schema allows mfa: true and
  # tailnet_only: true together) must not redefine the same matcher name twice in
  # one server block.
  @not_tailscale_hard not remote_ip {{ tailscale_subnet }} {{ tailscale_subnet_v6 }}
  respond @not_tailscale_hard 404
}

(dns01_tls) {
  # DNS-01 cert issuance for the two Cloudflare-proxy-bound routes (epic 19, #02):
  # HTTP-01/TLS-ALPN-01 (automatic HTTPS's default challenges, used everywhere else
  # via the bare https:// scheme below) require the origin to be directly reachable,
  # which breaks once these hosts' DNS records are Cloudflare-proxied. DNS-01 proves
  # ownership via a DNS TXT record instead, needing no inbound reachability at all.
  # Same snippet+import shape as mfa_auth/tailnet_only above, imported by exactly
  # the routes named in dns01_hosts below — a deliberate, explicit special case, not
  # inferred from tls_mode alone (rejected: a hypothetical future tls_mode:auto route
  # might not need or want DNS-01, e.g. one whose DNS record stays unproxied), and
  # not a new schema field (two live cases don't justify one — see epic 19 spec's
  # Out of Scope).
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
}

{# TLS rendering per route (verified with `caddy adapt`/`caddy run`, v2.11):
   - tls_mode "auto" → https:// scheme prefix, NO tls directive: automatic HTTPS
     issues a real ACME cert, including on custom ports like :8443 (a bare `tls`
     line is a Caddyfile parse error and prevents Caddy from starting).
   - tls_mode "internal" or unset → bare address + `tls internal` (locally
     trusted CA — the pre-epic-12 behavior for all routes).
   - matrix/owntracks specifically (epic 19, #02) also `import dns01_tls` — see
     that snippet's own comment above.
   - Every mfa/tailnet_only-gated route (epic 20) ALSO gets a second, entirely
     separate site block for the SAME hostname, bound to the shared Unix
     socket instead of the normal :443/:8443 listener — the internal listener
     defined above. Not a second comma-joined address on the SAME block (that
     was the original design for a TCP port; verified via `caddy adapt` that
     it doesn't work for a Unix-socket address mixed with a normal hostname
     address — Caddy mis-parses it as a URL host+path match instead of a
     second listener). Two site blocks sharing one hostname is Caddy's own
     documented pattern for "the same site, reachable via two different bind
     addresses" (see the `bind` directive's own docs). Routes with neither
     flag (owntracks recorder, matrix — and auth itself, which has no
     mfa/tailnet_only import since Authelia obviously doesn't gate its own
     login portal) don't gain this second block, since they have no
     source-IP check that tailnet-facing masquerade could ever break. #}
{% set dns01_hosts = ['matrix', 'owntracks'] %}
{% set relay_socket_bind = 'unix//caddy-relay-socket/caddy-relay.sock|0666' %}
{% macro site_block(route, auto_tls, bind_line=none) %}
{% if auto_tls %}https://{% endif %}{{ route.host }}.{{ secrets.silverbullet_domain }}{% if route.port is defined %}:{{ route.port }}{% endif %} {
{% if bind_line %}  bind {{ bind_line }}
{% endif %}  log
{% if not auto_tls %}  tls internal
{% endif %}{% if auto_tls and route.host in dns01_hosts %}  import dns01_tls
{% endif %}
{# tailnet_only is optional (schema required: false) so it needs the `is defined`
   guard below, same as tls_mode/port/basic_auth_user above — mfa needs no such
   guard because the schema requires it on every route, so it's always present. #}
{% if route.tailnet_only is defined and route.tailnet_only %}  import tailnet_only
{% endif %}{% if route.mfa %}  import mfa_auth
{% endif %}{% if route.basic_auth_user is defined %}  basic_auth {
    {{ route.basic_auth_user }} {{ route.basic_auth_hash }}
  }
{% endif %}  reverse_proxy {{ route.upstream }}
}
{% endmacro %}
{% for route in gateway_routes %}
{% set auto_tls = route.tls_mode is defined and route.tls_mode == 'auto' %}
{% set source_ip_gated = route.mfa or (route.tailnet_only is defined and route.tailnet_only) %}
{{ site_block(route, auto_tls) }}
{% if source_ip_gated %}
{{ site_block(route, auto_tls, bind_line=relay_socket_bind) }}
{% endif %}
{% endfor %}
