{
  # ACME contact (epic 12 #05/#08): Let's Encrypt expiry/abuse notices.
  email {{ secrets.acme_email }}
  servers {
    trusted_proxies static private_ranges
  }
}

(mfa_auth) {
  # Source-based MFA (ADR-0001): Tailscale (VPN) clients are already authenticated and
  # encrypted, so they skip Authelia; everyone else (public net) is challenged. The subnet
  # is the single constant shared with the tailscale role's ufw allow.
  @not_tailscale not remote_ip {{ tailscale_subnet }}
  forward_auth @not_tailscale authelia:9091 {
    uri /api/authz/forward-auth?authelia_url=https://auth.<secret-silverbullet-domain>
    copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
  }
}

{# TLS rendering per route (verified with `caddy adapt`/`caddy run`, v2.11):
   - tls_mode "auto" → https:// scheme prefix, NO tls directive: automatic HTTPS
     issues a real ACME cert, including on custom ports like :8448 (a bare `tls`
     line is a Caddyfile parse error and prevents Caddy from starting).
   - tls_mode "internal" or unset → bare address + `tls internal` (locally
     trusted CA — the pre-epic-12 behavior for all routes). #}
{% for route in gateway_routes %}
{% set auto_tls = route.tls_mode is defined and route.tls_mode == 'auto' %}
{% if auto_tls %}https://{% endif %}{{ route.host }}.{{ secrets.silverbullet_domain }}{% if route.port is defined %}:{{ route.port }}{% endif %} {
  log
{% if not auto_tls %}  tls internal
{% endif %}
{% if route.mfa %}  import mfa_auth
{% endif %}{% if route.basic_auth_user is defined %}  basic_auth {
    {{ route.basic_auth_user }} {{ route.basic_auth_hash }}
  }
{% endif %}  reverse_proxy {{ route.upstream }}
}
{% endfor %}
