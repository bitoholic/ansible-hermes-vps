{
  servers {
    trusted_proxies static private_ranges [IP_ADDRESS]/13 [IP_ADDRESS]/15 [IP_ADDRESS]/18 [IP_ADDRESS]/17 [IP_ADDRESS]/20 [IP_ADDRESS]/22 [IP_ADDRESS]/22 [IP_ADDRESS]/22 [IP_ADDRESS]/18 [IP_ADDRESS]/13 [IP_ADDRESS]/14 [IP_ADDRESS]/20 [IP_ADDRESS]/20 [IP_ADDRESS]/22
  }
}

(mfa_auth) {
  # Source-based MFA (ADR-0001): Tailscale (VPN) clients are already authenticated and
  # encrypted, so they skip Authelia; everyone else (public net) is challenged. The subnet
  # is the single constant shared with the tailscale role's ufw allow.
  @not_tailscale not remote_ip {{ tailscale_subnet }}
  forward_auth @not_tailscale authelia:9091 {
    uri /api/authz/forward-auth?authelia_url=https://auth.<secret-silverbullet-domain>
    copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
  }
}

{% for route in gateway_routes %}
{{ route.host }}.{{ secrets.silverbullet_domain }} {
  log
  tls internal
{{ '  import mfa_auth
' if route.mfa else '' }}  reverse_proxy {{ route.upstream }}
}
{% endfor %}

# Matrix (Conduit) HTTPS listener — Tailscale-only via UFW.
# Caddy terminates TLS on 8448 and proxies to Conduit (plain HTTP on localhost:8008).
{{ secrets.silverbullet_domain }}:8448 {
  tls internal
  reverse_proxy http://{{ inventory_hostname }}:{{ conduit_port }}
}
