# PROXY-protocol relay for tailnet-facing access (epic 20) — see
# roles/gateway/templates/Caddyfile.j2's own comment for the full root-cause
# and security-boundary rationale. Pure TCP passthrough: HAProxy never
# terminates TLS itself, it only injects a PROXY protocol v2 header carrying
# the real client IP before forwarding to Caddy's internal listener, which
# does the actual TLS handshake.
#
# Bind addresses are this VPS's own Tailscale IP(s), queried at deploy time
# (roles/tailscale/tasks/main.yml, via `tailscale ip`) — never 0.0.0.0/all
# interfaces. A bind line is rendered only when that address family's fact is
# actually non-empty (e.g. a --check run before Tailscale has ever come up):
# an unconditional `bind :443` with an empty address would silently become an
# unscoped, all-interfaces bind, defeating the entire point of this relay.
global
    maxconn 256
    # user/group haproxy (found on the live VPS via a real crash-loop): the
    # container itself runs as root (roles/docker/templates/services/
    # caddy-relay.yml.j2's own comment has the full story — the image's own
    # non-root USER directive left cap_add: NET_BIND_SERVICE with nothing to
    # attach to, and network_mode: host rules out the sysctl alternative) so
    # the master process can bind privileged port 443 directly; these two
    # directives are HAProxy's own standard mechanism for dropping to the
    # unprivileged `haproxy` user/group (baked into this image) immediately
    # after every listening socket is already bound. Verified this user/group
    # actually exists in the image (`docker inspect` showed Config.User:
    # "haproxy" as its own default), so this isn't inventing a new identity.
    user haproxy
    group haproxy
    # chroot INTO the shared socket directory itself (not /var/empty, an
    # earlier version of this file's own choice) — silences HAProxy's own
    # runtime warning about starting as root without a chroot, but more
    # importantly: this process needs filesystem access to exactly one thing
    # post-startup, the Unix socket to Caddy below, and nothing else (pure
    # TCP passthrough, no certs, no ACL files). Chrooting to /var/empty
    # instead would have made that socket path UNREACHABLE after the chroot
    # takes effect — a chrooted process can't see anything outside its new
    # root, including an absolute path that was valid before the chroot.
    # Caught before deploying, not live: reasoned through the exact
    # `connect()`-time path resolution rather than repeating this ticket's
    # earlier pattern of finding out via a crash-loop.
    chroot /caddy-relay-socket

defaults
    mode tcp
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend tailnet_https
{% if tailscale_ip_v4 %}    bind {{ tailscale_ip_v4 }}:443
{% endif %}{% if tailscale_ip_v6 %}    bind {{ tailscale_ip_v6 }}:443
{% endif %}    default_backend caddy_internal

backend caddy_internal
    # unix@/caddy-relay.sock, not a TCP address: a Unix domain socket shared
    # with Caddy's own container via the same host directory this process is
    # chrooted into above (both containers mount {{ caddy_relay_socket_dir }}
    # at their own internal paths — Caddy at /caddy-relay-socket, this
    # container at /caddy-relay-socket too, which then BECOMES this
    # container's "/" once chroot takes effect, so the socket at
    # {{ caddy_relay_socket_dir }}/caddy-relay.sock appears here simply as
    # /caddy-relay.sock). Replaced an earlier loopback-TCP-port design found,
    # in review, to be a real auth-bypass vector: Docker's own port-publish
    # NAT made ANY host-networked container's connection (not just this
    # one's) appear to originate from the same untrustable address range —
    # see roles/gateway/templates/Caddyfile.j2's own comment for the full
    # story. A Unix socket has no network-layer identity to spoof at all;
    # only a container with this exact directory bind-mounted can reach it.
    #
    # send-proxy-v2: PROXY protocol v2 (binary), not v1 (text) — v2 is the
    # more robust, modern format and cleanly supports both address families
    # in one wire format. Caddy's own proxy_protocol module — which ships
    # natively in the pinned Caddy version, no Dockerfile change needed, see
    # Caddyfile.j2's own comment — auto-detects the protocol version on
    # read, so no matching config is needed on Caddy's side. PROXY protocol
    # works the same way over a Unix socket as over TCP: it's a payload-level
    # header, transport-agnostic once the connection is established.
    server caddy unix@/caddy-relay.sock send-proxy-v2
