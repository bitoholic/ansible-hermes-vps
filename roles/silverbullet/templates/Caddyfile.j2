{
  servers {
    trusted_proxies static private_ranges 172.64.0.0/13 162.158.0.0/15 108.162.192.0/18 198.41.128.0/17 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 104.16.0.0/13 104.24.0.0/14 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22
  }
}

(mfa_auth) {
  forward_auth authelia:9091 {
    uri /api/authz/forward-auth?authelia_url=https://auth.<secret-silverbullet-domain>
    copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
  }
}

wiki.{{ silverbullet_domain }} {
  log
  tls internal
  import mfa_auth
  reverse_proxy silverbullet:3000
}

dash.{{ silverbullet_domain }} {
  log
  tls internal
  import mfa_auth
  reverse_proxy hermes-agent:9119
}

auth.{{ silverbullet_domain }} {
  log
  tls internal
  reverse_proxy authelia:9091
}