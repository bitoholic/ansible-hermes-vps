services:
  caddy:
    image: caddy:2.8.4
    container_name: caddy
    ports:
      - "80:80"
      - "443:443"
      - "8448:8448"
    volumes:
      - "{{ docker_compose_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "caddy_data:/data"
      - "caddy_config:/config"
    depends_on:
      - authelia
    networks:
      - gateway

  authelia:
    image: authelia/authelia:latest
    container_name: authelia
    user: "{{wiki_volume_uid}}:{{wiki_volume_gid}}"
    environment:
      - PUID={{wiki_volume_uid}}
      - PGID={{wiki_volume_gid}}
    volumes:
      - "{{ authelia_config_dir }}:/config:ro"
      - "{{ authelia_data_dir }}:/var/lib/authelia"
    networks:
      - public

  silverbullet:
    image: "{{ silverbullet_image }}"
    container_name: silverbullet
    user: "{{wiki_volume_uid}}:{{wiki_volume_gid}}"
    environment:
      - SB_USER={{ secrets.silverbullet_admin_username }}:{{ secrets.silverbullet_admin_password }}
    ports:
      - "127.0.0.1:3000:3000"
    volumes:
      - "{{ silverbullet_data_dir }}:/space"
    networks:
      - public

networks:
  public:
    driver: bridge
  proxy_net:
    external: true

volumes:
  caddy_data:
  caddy_config:
