#!/usr/bin/env bash
set -euo pipefail
cd "{{ silverbullet_data_dir }}"

remote_url="$(git config --get remote.origin.url)"
repo_path="${remote_url##*:}"
repo_path="${repo_path%.git}"
repo_path="${repo_path#/}"

if [[ -z "$repo_path" ]]; then
  echo "Could not parse repository path from remote URL: $remote_url"
  exit 1
fi

IFS='/' read -r owner repo <<< "$repo_path"
pr_body="{\"title\": \"Daily VPS sync from {{ backup_working_branch }}\", \"head\": \"{{ backup_working_branch }}\", \"base\": \"main\", \"body\": \"Automated daily PR from VPS sync branch.\"}"

response=$(curl -sS -w "\n%{http_code}" -X POST \
  -H "Authorization: token {{ backup_github_token }}" \
  -H "Accept: application/vnd.github+json" \
  https://api.github.com/repos/$owner/$repo/pulls \
  -d "$pr_body")

http_code=$(tail -n1 <<< "$response")
body=$(sed '$d' <<< "$response")

if [[ "$http_code" == "201" ]]; then
  echo "Created PR successfully."
  exit 0
fi

if [[ "$http_code" == "422" ]] && grep -q "A pull request already exists" <<< "$body"; then
  echo "Pull request already exists."
  exit 0
fi

if [[ "$http_code" == "422" ]] && grep -q "No commits between" <<< "$body"; then
  echo "No new commits to create a PR."
  exit 0
fi

echo "Failed to create PR: HTTP $http_code"
echo "$body"
exit 1
