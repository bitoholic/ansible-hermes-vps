#!/usr/bin/env bash
set -euo pipefail
cd "{{ silverbullet_data_dir }}"

current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$current_branch" != "{{ backup_working_branch }}" ]]; then
  echo "Switching to {{ backup_working_branch }}"
  git checkout "{{ backup_working_branch }}"
fi

git pull --rebase origin "{{ backup_working_branch }}"

git add -A
if git diff --cached --quiet; then
  echo "No changes to commit."
  exit 0
fi

git commit -m "{{ backup_commit_message }}"
git push origin "{{ backup_working_branch }}"
