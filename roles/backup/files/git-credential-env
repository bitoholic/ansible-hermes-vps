#!/usr/bin/env bash
# git credential helper + askpass for the Hermes VPS wiki repo.
# Supplies the GitHub token from the file GITHUB_TOKEN_FILE points at, so the token VALUE is never stored in
# .git/config or any remote URL, and never appears as a literal `VAR=value` on a command line: Ansible's own
# `environment:` directive inlines its values into the exact shell invocation it runs, which its connection plugin
# prints verbatim at high verbosity (-vvv+) regardless of the task's own no_log setting — no_log only redacts a
# task's ARGUMENTS and result, not that separate connection-level trace. A file path is not secret; its contents are.
set -euo pipefail

token="$(cat "${GITHUB_TOKEN_FILE:?GITHUB_TOKEN_FILE must be set}")"

case "${1:-}" in
  get)
    # credential helper 'get': git expects username/password on stdout.
    echo "username=x-access-token"
    echo "password=$token"
    ;;
  *)
    # askpass mode: git invokes with a prompt string and expects the answer on stdout.
    if [[ "${1:-}" == *Password* ]]; then
      echo "$token"
    else
      echo "x-access-token"
    fi
    ;;
esac
