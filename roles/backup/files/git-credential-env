#!/usr/bin/env bash
# git credential helper + askpass for the Hermes VPS wiki repo.
# Supplies the GitHub token from the GITHUB_TOKEN environment variable so the token VALUE is
# never stored in .git/config or any remote URL. Deployed with no secret embedded.
set -euo pipefail

token="${GITHUB_TOKEN:-}"

case "${1:-}" in
  get)
    # credential helper 'get': git expects username/password on stdout.
    echo "username=x-access-token"
    echo "password=$token"
    ;;
  *)
    # askpass mode: git invokes with a prompt string and expects the answer on stdout.
    if [[ "${1:-}" == *Password* ]]; then
      echo "$token"
    else
      echo "x-access-token"
    fi
    ;;
esac
