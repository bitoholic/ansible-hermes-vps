OPENROUTER_API_KEY="{{ secrets.hermes_default_openrouter_api_key }}"
NOUS_API_KEY="{{ secrets.hermes_default_nous_portal_api_key }}"
GITHUB_TOKEN="{{ secrets.hermes_default_github_token }}"
SIGNAL_HTTP_URL="{{ hermes_signal_http_url }}"
SIGNAL_ACCOUNT="{{ secrets.hermes_signal_account }}"
SIGNAL_ALLOWED_USERS="{{ secrets.hermes_signal_allowed_users }}"
SIGNAL_HOME_CHANNEL="{{ secrets.hermes_signal_allowed_users }}"
GIT_AUTHOR_NAME="{{ secrets.git_username | default('', true) }}"
GIT_AUTHOR_EMAIL="{{ secrets.git_email | default('', true) }}"
GIT_COMMITTER_NAME="{{ secrets.git_username | default('', true) }}"
GIT_COMMITTER_EMAIL="{{ secrets.git_email | default('', true) }}"
HERMES_WRITE_SAFE_ROOT="/opt/data:/tmp"
RESEND_API_KEY="{{ secrets.hermes_default_resend_api_key | default('', true) }}"

# Matrix transport (personal Conduit homeserver) — default profile only (epic 06 #03)
MATRIX_HOMESERVER="{{ conduit_internal_url }}"
MATRIX_USER_ID="@hermes:{{ conduit_server_name }}"
MATRIX_PASSWORD="{{ secrets.matrix_bot_password }}"
MATRIX_ALLOWED_USERS="{{ secrets.matrix_allowed_users }}"
MATRIX_ALLOWED_ROOMS="{{ secrets.matrix_allowed_rooms | default('', true) }}"
MATRIX_E2EE_MODE="{{ conduit_e2ee_mode }}"
MATRIX_DEVICE_ID="HERMES_BOT"
