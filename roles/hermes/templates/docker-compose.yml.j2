services:
  signal-cli:
    image: registry.gitlab.com/packaging/signal-cli/signal-cli-native:latest
    container_name: signal-cli
    restart: unless-stopped
    user: "{{wiki_volume_uid}}:{{wiki_volume_gid}}"
    volumes:
      - "/opt/hermes/signal-data:/var/lib/signal-cli"
    tmpfs:
      - /tmp:exec
    command:
      - "--config"
      - "/var/lib/signal-cli"
      - "-u"
      - "{{ secrets.hermes_signal_account }}"
      - "daemon"
      - "--http"
      - "0.0.0.0:8080"
    networks:
      - hermes_net

  hermes-agent:
    #image: ghcr.io/nousresearch/hermes-agent:latest
    build:
      context: .
      dockerfile: Dockerfile
    container_name: "hermes-agent"
    restart: unless-stopped
    command: ["hermes", "gateway"]
    depends_on:
      - signal-cli
    ports:
      - "127.0.0.1:8642:8642"
      - "127.0.0.1:9119:9119"
    environment:
      HERMES_DASHBOARD: "1"
      HERMES_UID: "{{wiki_volume_uid}}"
      HERMES_GID: "{{wiki_volume_gid}}"
      GITHUB_TOKEN: "{{secrets.hermes_default_github_token}}"
    volumes:
      - "{{ hermes_home }}:/opt/data"
      - "{{ silverbullet_data_dir }}:/opt/data/wiki"
    networks:
      - hermes_net
      - proxy_net

networks:
  hermes_net:
    external: true
  proxy_net:
    external: true
