{# Shared Hermes config template, parameterized by the active profile entry (`item`). #}
{# Every `hermes_profiles` entry renders through this one file; per-profile divergence #}
{# lives as data on the entry (model_*, enable_base_features, enable_web/browser, #}
{# mcp_servers, tools_disabled, skills_auto_load, dashboard, onboarding_seen) rather #}
{# than in a separate template file. Output is semantically identical to the previous #}
{# three per-profile templates. #}
model:
  provider: {{ item.model_provider | default('nous') }}
  default: {{ item.model_default | default('deepseek/deepseek-v4-flash') }}

{% if item.terminal_cwd is defined %}
terminal:
  cwd: {{ item.terminal_cwd }}
{% endif %}

{% if item.tools_disabled is defined %}
tools:
{% for tool in item.tools_disabled %}
  {{ tool }}:
    enabled: false
{% endfor %}
{% endif %}

{% if item.enable_web | default(false) %}
web:
  backend: nous
  use_gateway: true
{% endif %}

{% if item.enable_browser | default(false) %}
browser:
  backend: nous
  use_gateway: true
{% endif %}

{% if item.enable_base_features | default(false) %}
compression:
  enabled: true
  threshold: 0.5
display:
  runtime_footer:
    fields:
      - model
      - context_pct
      - cwd
tts:
  provider: neutts
  neutts:
    model: neuphonic/neutts-air-q4-gguf
    device: cpu
stt:
  enabled: true
  provider: local
  local:
    model: base
delegation:
  max_concurrent_children: 3
  provider: nous
  model: qwen/qwen3-coder-flash
{% endif %}

{% if item.mcp_servers | default([]) | length > 0 %}
mcp_servers:
{% for server in item.mcp_servers %}
  {{ server.name }}:
    command: {{ server.command | default('npx') }}
    args:
      - -y
      - "{{ server.pkg }}"
{% if server.env is defined %}
    env:
{% for key, value in server.env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

{% if item.skills_auto_load is defined %}
skills:
  auto_load:
{% for skill in item.skills_auto_load %}
    - {{ skill }}
{% endfor %}
{% endif %}

{% if item.enable_base_features | default(false) %}
timezone: Europe/London
security:
  tirith_enabled: true
image_gen:
  use_gateway: true
video_gen:
  provider: fal
  use_gateway: true
{% endif %}

{% if item.onboarding_seen is defined %}
onboarding:
  seen:
    {{ item.onboarding_seen }}: true
{% endif %}

{% if item.dashboard | default(false) %}
dashboard:
  host: "0.0.0.0"
  port: 9119
  basic_auth:
    username: "admin"
    password_hash: "{{ secrets.hermes_default_dashboard_admin_password_hash }}"
{% endif %}
