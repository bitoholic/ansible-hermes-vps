model:
  provider: nous
  default: deepseek/deepseek-v4-flash
terminal:
  cwd: /opt/data/wiki
web:
  backend: nous
  use_gateway: true
browser:
  backend: nous
  use_gateway: true
compression:
  enabled: true
  threshold: 0.5
display:
  runtime_footer:
    fields:
      - model
      - context_pct
      - cwd
tts:
  provider: neutts
  neutts:
    model: neuphonic/neutts-air-q4-gguf
    device: cpu
stt:
  enabled: true
  provider: local
  local:
    model: base
delegation:
  max_concurrent_children: 3
  provider: nous
  model: qwen/qwen3-coder-flash
mcp_servers:
  context7:
    command: npx
    args:
      - -y
      - "@upstash/context7-mcp"
    env:
      CONTEXT7_API_KEY: ctx7sk-ed3645d4-e247-4110-a11a-fdb85c3a5db1
  github:
    command: npx
    args:
      - -y
      - "@modelcontextprotocol/server-github"
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: "«redacted:github_pat_…»"
  playwright:
    command: npx
    args:
      - -y
      - "@modelcontextprotocol/server-playwright"
skills:
  auto_load:
    - research/llm-wiki
timezone: Europe/London
security:
  tirith_enabled: true
onboarding:
  seen:
    busy_input_prompt: true
image_gen:
  use_gateway: true
video_gen:
  provider: fal
  use_gateway: true
