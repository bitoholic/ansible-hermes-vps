owntracks:
  image: owntracks/recorder:latest
  container_name: owntracks
  user: "{{ wiki_volume_uid }}:{{ wiki_volume_gid }}"
  environment:
    # OTR_PORT/OTR_HOST configure the MQTT client — disabled (0): no broker in
    # this stack. The HTTP server is OTR_HTTPPORT binding OTR_HTTPHOST; it must
    # bind all interfaces so Caddy on the gateway network can reach it.
    - OTR_PORT=0
    - OTR_HTTPHOST={{ docker_bind_address }}
    - OTR_HTTPPORT=8083
    - OTR_STORAGEDIR=/store
    # No auth env var here on purpose: the recorder has no built-in HTTP auth
    # (see doc/SECURITY.md upstream). Caddy's basic_auth directive is the real
    # enforcement point (roles/gateway/templates/Caddyfile.j2).
  volumes:
    # Host bind-mount (owned by the container uid, see owntracks_data_dir) — a
    # named volume initializes root-owned and the non-root recorder cannot
    # create its storage subdirectories.
    - "{{ owntracks_data_dir }}:/store"
  networks:
    - gateway
  restart: unless-stopped
