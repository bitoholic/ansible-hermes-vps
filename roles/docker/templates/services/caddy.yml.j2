caddy:
  image: caddy:2.8.4
  container_name: caddy
  ports:
    - "80:80"
    - "443:443"
    - "8448:8448"
  volumes:
    - "{{ silverbullet_compose_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
    - "caddy_data:/data"
    - "caddy_config:/config"
  depends_on:
    - authelia
  networks:
    - gateway
