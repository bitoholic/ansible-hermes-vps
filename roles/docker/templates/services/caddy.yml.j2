caddy:
  # Built from a local Dockerfile (epic 19, #01) — not a pulled stock image —
  # to compile in the Cloudflare DNS plugin (roles/gateway/files/Dockerfile
  # has the full rationale). Build context is a dedicated directory
  # (roles/docker/tasks/main.yml copies the Dockerfile there) so this doesn't
  # accidentally pull in the whole compose-dir tree as build context.
  build:
    context: "{{ docker_compose_dir }}/caddy"
    dockerfile: Dockerfile
  container_name: caddy
  # 8443, not 8448 (epic 19, #02): Cloudflare's proxy allowlist includes 8443,
  # not 8448 — see roles/conduit/defaults/main.yml's own comment for the full
  # rationale. Both matrix and owntracks (the two SNI-sharers on this port)
  # move together.
  #
  # 443 is bound to this VPS's own public IP specifically (epic 20), not
  # 0.0.0.0 — freeing the exact <tailscale-ip>:443 combination for the
  # caddy-relay container to bind exclusively. 80 stays unscoped: it only ever
  # serves Caddy's automatic HTTP->HTTPS redirect, which runs before any
  # mfa_auth/tailnet_only matcher does, so it has no source-IP check the
  # tailnet-facing masquerade bug could break — no relay path needed for it.
  # 8443 (matrix/owntracks) is untouched for the same reason: neither route
  # has any source-based access control to begin with.
  #
  # 127.0.0.1:{{ caddy_proxy_protocol_port }} (epic 20): the internal,
  # PROXY-protocol-trusting listener defined in Caddyfile.j2's global options
  # — reachable only by the caddy-relay container's own loopback-bound
  # forward, never the public internet or the Docker bridge's externally-
  # reachable side. Half of this listener's defense-in-depth (the other half
  # is the listener's own `allow 127.0.0.1/32 ::1/128` restriction) — see
  # Caddyfile.j2's own comment for the full security-boundary rationale.
  ports:
    - "80:80"
    - "{{ ansible_default_ipv4.address }}:443:443"
    - "127.0.0.1:{{ caddy_proxy_protocol_port }}:{{ caddy_proxy_protocol_port }}"
    - "8443:8443"
  # CLOUDFLARE_API_TOKEN (epic 19, #02): read by Caddyfile.j2's DNS-01
  # directive via Caddy's own {env.CLOUDFLARE_API_TOKEN} placeholder — not
  # baked into the rendered Caddyfile as a literal value.
  environment:
    - CLOUDFLARE_API_TOKEN={{ secrets.cloudflare_api_token }}
  volumes:
    - "{{ docker_compose_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
    - "caddy_data:/data"
    - "caddy_config:/config"
  depends_on:
    - authelia
  networks:
    - gateway
