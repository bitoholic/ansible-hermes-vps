caddy:
  # Built from a local Dockerfile (epic 19, #01) — not a pulled stock image —
  # to compile in the Cloudflare DNS plugin (roles/gateway/files/Dockerfile
  # has the full rationale). Build context is a dedicated directory
  # (roles/docker/tasks/main.yml copies the Dockerfile there) so this doesn't
  # accidentally pull in the whole compose-dir tree as build context.
  build:
    context: "{{ docker_compose_dir }}/caddy"
    dockerfile: Dockerfile
  container_name: caddy
  # 8443, not 8448 (epic 19, #02): Cloudflare's proxy allowlist includes 8443,
  # not 8448 — see roles/conduit/defaults/main.yml's own comment for the full
  # rationale. Both matrix and owntracks (the two SNI-sharers on this port)
  # move together.
  ports:
    - "80:80"
    - "443:443"
    - "8443:8443"
  # CLOUDFLARE_API_TOKEN (epic 19, #02): read by Caddyfile.j2's DNS-01
  # directive via Caddy's own {env.CLOUDFLARE_API_TOKEN} placeholder — not
  # baked into the rendered Caddyfile as a literal value.
  environment:
    - CLOUDFLARE_API_TOKEN={{ secrets.cloudflare_api_token }}
  volumes:
    - "{{ docker_compose_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
    - "caddy_data:/data"
    - "caddy_config:/config"
  depends_on:
    - authelia
  networks:
    - gateway
