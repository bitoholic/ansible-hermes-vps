{
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "scripts/deploy"
    ],
    "network": {
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "denyRead": [
        "./.env"
      ],
      "allowWrite": [
        "/run/user/**",
        "/dev/shm/**",
        "~/.ansible/tmp/**"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(scripts/deploy)",
      "Bash(scripts/deploy:*)",
      "Bash(scripts/secrets check)",
      "Bash(scripts/secrets init-key)",
      "Bash(scripts/secrets init-key:*)"
    ],
    "deny": [
      "Bash(sops decrypt:*)",
      "Bash(sops exec:*)",
      "Bash(env)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(scripts/secrets fill:*)",
      "Bash(scripts/secrets edit:*)",
      "Bash(scripts/secrets rotate:*)",
      "Bash(scripts/secrets add-recipient:*)",
      "Bash(scripts/secrets remove-recipient:*)",
      "Bash(scripts/secrets import:*)",
      "Bash(cat ~/.config/sops/age/*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Read(.env)"
    ]
  }
}
